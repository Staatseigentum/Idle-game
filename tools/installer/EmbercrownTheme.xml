<?xml version="1.0" encoding="utf-8"?>
<!-- The names of buttons and status controls are WixStdBA's interface; their positions,
     fonts, copy, colors and artwork are Embercrown's and can be edited here. -->
<Theme xmlns="http://wixtoolset.org/schemas/thmutil/2010">
  <!-- WS_POPUP | WS_VISIBLE removes the native caption. ThmUtil treats blank space as a drag area. -->
  <Window Width="740" Height="408" HexStyle="90000000" FontId="0">#(loc.Caption)</Window>
  <!-- WiX theme colors are Windows COLORREF (BGR), not web RGB. -->
  <Font Id="0" Height="-12" Weight="500" Foreground="C7D2D8" Background="271811">Segoe UI</Font>
  <Font Id="1" Height="-26" Weight="700" Foreground="6BC6F3" Background="271811">Consolas</Font>
  <Font Id="2" Height="-16" Weight="600" Foreground="5DA3EB" Background="271811">Consolas</Font>
  <Font Id="3" Height="-13" Weight="500" Foreground="D7D0CB" Background="271811">Segoe UI</Font>
  <Font Id="4" Height="-12" Weight="500" Foreground="6BC6F3" Background="271811" Underline="yes">Segoe UI</Font>

  <!-- Non-paged controls give every step the same Embercrown title bar. -->
  <Image X="0" Y="0" Width="740" Height="38" ImageFile="titlebar.png" Visible="yes" />
  <Text X="51" Y="9" Width="260" Height="23" FontId="2" Visible="yes" DisablePrefix="yes">EMBERCROWN</Text>
  <Text X="544" Y="11" Width="105" Height="20" FontId="3" Visible="yes" DisablePrefix="yes">SETUP</Text>
  <Button Name="MinimizeButton" X="662" Y="5" Width="28" Height="28" TabStop="yes" FontId="0" ImageFile="titlebar-minimize.png" Visible="yes" />
  <Button Name="CloseButton" X="699" Y="5" Width="28" Height="28" TabStop="yes" FontId="0" ImageFile="titlebar-close.png" Visible="yes" />

  <!-- The cover is a tracked, procedurally generated game asset; no remote image is loaded. -->
  <Image X="12" Y="50" Width="314" Height="249" ImageFile="cover.png" Visible="yes" />
  <Text X="353" Y="55" Width="365" Height="42" FontId="1" Visible="yes" DisablePrefix="yes">EMBERCROWN</Text>
  <Text X="353" Y="107" Width="365" Height="25" FontId="2" Visible="yes" DisablePrefix="yes">THE LAST LIGHT</Text>
  <Text X="12" Y="310" Width="314" Height="57" FontId="3" Visible="yes" DisablePrefix="yes">Rebuild a fallen kingdom. Keep its last light alive.</Text>

  <Page Name="Help">
    <Text X="353" Y="151" Width="365" Height="30" FontId="2" DisablePrefix="yes">SETUP HELP</Text>
    <Text X="353" Y="187" Width="365" Height="125" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Text>
    <Button Name="HelpCancelButton" X="545" Y="364" Width="173" Height="26" TabStop="yes" FontId="0">#(loc.HelpCloseButton)</Button>
  </Page>

  <Page Name="Install">
    <Text X="353" Y="150" Width="365" Height="30" FontId="2" DisablePrefix="yes">RESTORE THE KINGDOM</Text>
    <Text X="353" Y="188" Width="365" Height="73" FontId="3" DisablePrefix="yes">Install Embercrown and begin your reign. The launcher checks for new game versions when you start it.</Text>
    <Hypertext Name="EulaHyperlink" X="353" Y="269" Width="365" Height="32" TabStop="yes" FontId="4" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
    <Checkbox Name="EulaAcceptCheckbox" X="353" Y="305" Width="365" Height="20" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
    <Button Name="OptionsButton" X="353" Y="364" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.InstallOptionsButton)</Button>
    <Button Name="InstallButton" X="449" Y="364" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
    <Button Name="WelcomeCancelButton" X="545" Y="364" Width="173" Height="26" TabStop="yes" FontId="0">#(loc.InstallCloseButton)</Button>
  </Page>

  <Page Name="Options">
    <Text X="353" Y="150" Width="365" Height="30" FontId="2" DisablePrefix="yes">INSTALL OPTIONS</Text>
    <Text X="353" Y="189" Width="365" Height="24" FontId="3" DisablePrefix="yes">#(loc.OptionsLocationLabel)</Text>
    <Editbox Name="FolderEditbox" X="353" Y="223" Width="267" Height="23" TabStop="yes" FontId="3" FileSystemAutoComplete="yes" />
    <Button Name="BrowseButton" X="630" Y="222" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.OptionsBrowseButton)</Button>
    <Button Name="OptionsOkButton" X="535" Y="364" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.OptionsOkButton)</Button>
    <Button Name="OptionsCancelButton" X="630" Y="364" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.OptionsCancelButton)</Button>
  </Page>

  <Page Name="FilesInUse">
    <Text X="353" Y="150" Width="365" Height="30" FontId="2" DisablePrefix="yes">CLOSE OPEN FILES</Text>
    <Text X="353" Y="189" Width="365" Height="34" FontId="3" DisablePrefix="yes">#(loc.FilesInUseLabel)</Text>
    <Text Name="FilesInUseText" X="353" Y="228" Width="365" Height="69" FontId="3" DisablePrefix="yes" HexStyle="0x0000C000" />
    <Button Name="FilesInUseCloseRadioButton" X="353" Y="308" Width="365" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes" HexStyle="0x000009">#(loc.FilesInUseCloseRadioButton)</Button>
    <Button Name="FilesInUseDontCloseRadioButton" X="353" Y="331" Width="365" Height="23" TabStop="yes" FontId="0" HideWhenDisabled="yes" HexStyle="0x000009">#(loc.FilesInUseDontCloseRadioButton)</Button>
    <Button Name="FilesInUseOkButton" X="535" Y="364" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FilesInUseOkButton)</Button>
    <Button Name="FilesInUseCancelButton" X="630" Y="364" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.FilesInUseCancelButton)</Button>
  </Page>

  <Page Name="Progress">
    <Text X="353" Y="150" Width="365" Height="30" FontId="2" DisablePrefix="yes">LIGHTING THE BEACON</Text>
    <Text Name="OverallProgressPackageText" X="353" Y="193" Width="365" Height="28" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Text>
    <Progressbar Name="OverallCalculatedProgressbar" X="353" Y="237" Width="365" Height="18" />
    <Button Name="ProgressCancelButton" X="630" Y="364" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
  </Page>

  <Page Name="Modify">
    <Text X="353" Y="150" Width="365" Height="30" FontId="2" DisablePrefix="yes">YOUR KINGDOM AWAITS</Text>
    <Text X="353" Y="189" Width="365" Height="53" FontId="3" DisablePrefix="yes">Embercrown is already installed. Repair the launcher or remove the application.</Text>
    <Button Name="RepairButton" X="353" Y="364" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
    <Button Name="UninstallButton" X="449" Y="364" Width="88" Height="26" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
    <Button Name="ModifyCancelButton" X="545" Y="364" Width="173" Height="26" TabStop="yes" FontId="0">#(loc.ModifyCloseButton)</Button>
  </Page>

  <Page Name="Success">
    <Text Name="SuccessHeader" X="353" Y="150" Width="365" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessHeader)</Text>
    <Text Name="SuccessInstallHeader" X="353" Y="150" Width="365" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">THE FIRE IS LIT</Text>
    <Text Name="SuccessRepairHeader" X="353" Y="150" Width="365" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessRepairHeader)</Text>
    <Text Name="SuccessUninstallHeader" X="353" Y="150" Width="365" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessUninstallHeader)</Text>
    <Text X="353" Y="195" Width="365" Height="69" FontId="3" DisablePrefix="yes">Setup is complete. Your saved progress lives outside the installation folder.</Text>
    <Button Name="LaunchButton" X="449" Y="364" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessLaunchButton)</Button>
    <Text Name="SuccessRestartText" X="353" Y="310" Width="365" Height="40" FontId="3" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.SuccessRestartText)</Text>
    <Button Name="SuccessRestartButton" X="449" Y="364" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
    <Button Name="SuccessCancelButton" X="545" Y="364" Width="173" Height="26" TabStop="yes" FontId="0">#(loc.SuccessCloseButton)</Button>
  </Page>

  <Page Name="Failure">
    <Text Name="FailureHeader" X="353" Y="150" Width="365" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureHeader)</Text>
    <Text Name="FailureInstallHeader" X="353" Y="150" Width="365" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">THE FLAME FALTERED</Text>
    <Text Name="FailureUninstallHeader" X="353" Y="150" Width="365" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureUninstallHeader)</Text>
    <Text Name="FailureRepairHeader" X="353" Y="150" Width="365" Height="32" FontId="2" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureRepairHeader)</Text>
    <Hypertext Name="FailureLogFileLink" X="353" Y="192" Width="365" Height="42" FontId="4" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
    <Hypertext Name="FailureMessageText" X="353" Y="238" Width="365" Height="58" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
    <Text Name="FailureRestartText" X="353" Y="310" Width="365" Height="40" FontId="3" HideWhenDisabled="yes" DisablePrefix="yes">#(loc.FailureRestartText)</Text>
    <Button Name="FailureRestartButton" X="449" Y="364" Width="88" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
    <Button Name="FailureCloseButton" X="545" Y="364" Width="173" Height="26" TabStop="yes" FontId="0">#(loc.FailureCloseButton)</Button>
  </Page>
</Theme>
