    <string name="chronicle_camp">The first fire since the last one went out.</string>
    <string name="chronicle_hamlet">A handful of tents remember your name.</string>
    <string name="chronicle_village">Roots again, thin and trembling.</string>
    <string name="chronicle_market_town">Strangers arrive selling things you almost recall inventing.</string>
    <string name="chronicle_town">Walls rise faster than the doubt that you\'ll need them.</string>
    <string name="chronicle_free_city">No liege but the one inside your own chest.</string>
    <string name="chronicle_county">A title, again. It fits the way old shoes fit.</string>
    <string name="chronicle_duchy">Other lords bow. They don\'t know how many times you\'ve bowed first.</string>
    <string name="chronicle_kingdom">A crown, heavier each time, lighter each time you remember how to wear it.</string>
    <string name="chronicle_united_kingdom">Old borders forget they were ever borders.</string>
    <string name="chronicle_empire">The map runs out before your ambition does.</string>
    <string name="chronicle_continental_realm">Horizons stop being an excuse.</string>
    <string name="chronicle_legendary_realm">Bards stop asking if the stories are true.</string>
    <string name="chronicle_realm_of_dreams">Sleep and rule start to share a border.</string>
    <string name="chronicle_shadow_realm">Even the Blight hesitates here.</string>
    <string name="chronicle_realm_of_stars">You stop counting years and start counting lights.</string>
    <string name="chronicle_eternal_realm">Forever, tried on like a coat that almost fits.</string>
    <string name="chronicle_embercrown">The throne was always made of what was left over.</string>
